# Copy to .env.local and fill in — never commit .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional — enables natural "studio" listen-aloud voices (OpenAI TTS).
# Without it, lessons fall back to the device's built-in voice.
OPENAI_API_KEY=
ESV_API_KEY=
RESEND_API_KEY=
ENCRYPTION_KEY=            # 32-byte key for BYOK encryption (later milestone)
